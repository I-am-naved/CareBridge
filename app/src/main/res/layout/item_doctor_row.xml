<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="#FFFFFF"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/docName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#173B57"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/docSpecialty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#475467"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/docSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#667085"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/docStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#E8F5F2"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:textColor="#2D8C88"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
