<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nearbyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7FB"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Toolbar -->
    <LinearLayout
        android:id="@+id/nearbyToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBackNearby"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go back to CareBridge"
            android:src="@drawable/ic_arrow_back"
            app:tint="#073B63" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Healthcare Map"
                android:textColor="#073B63"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/toolbarSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Find hospitals, clinics, pharmacies &amp; labs near you"
                android:textColor="#66788A"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Map Container Frame -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="210dp">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mapFragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btnMyLocation"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_icon_circle"
            android:backgroundTint="#FFFFFF"
            android:contentDescription="Re-center location"
            android:elevation="4dp"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_mylocation"
            app:tint="#073B63" />
    </FrameLayout>

    <!-- Search & Filter Controls Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <!-- Search bar and radius spinner row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:backgroundTint="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etSearchNearby"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Search facility by name..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="#073B63"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnClearSearch"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear search"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:visibility="gone"
                    app:tint="#94A3B8" />

            </LinearLayout>

            <Spinner
                android:id="@+id/spinnerRadius"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="#FFFFFF"
                android:paddingHorizontal="10dp" />

        </LinearLayout>

        <!-- Location Status Message -->
        <TextView
            android:id="@+id/locationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Finding your location…"
            android:textColor="#66788A"
            android:textSize="12sp" />

        <!-- Category chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    style="@style/NearbyFilterChip.Selected"
                    android:text="All" />

                <TextView
                    android:id="@+id/chipHospitals"
                    style="@style/NearbyFilterChip"
                    android:text="Hospitals" />

                <TextView
                    android:id="@+id/chipClinics"
                    style="@style/NearbyFilterChip"
                    android:text="Clinics" />

                <TextView
                    android:id="@+id/chipPharmacies"
                    style="@style/NearbyFilterChip"
                    android:text="Pharmacies" />

                <TextView
                    android:id="@+id/chipLabs"
                    style="@style/NearbyFilterChip"
                    android:text="Laboratories" />

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/nearbyLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="#0A8F91"
        android:visibility="visible" />

    <!-- Error/Empty State Container with Retry Button -->
    <LinearLayout
        android:id="@+id/errorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_nearby_empty"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/emptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Nearby services will appear here."
            android:textColor="#526579"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRetryLocation"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#073B63"
            android:text="🔄 Retry Location"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNearbyPlaces"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="18dp"
        android:paddingTop="4dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp"
        android:visibility="visible" />

</LinearLayout>
