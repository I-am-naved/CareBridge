<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#E8F5F2"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Appointment Offer Available"
        android:textColor="#2D8C88"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/offerProvider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#173B57"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/offerDepartment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#475467"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/offerLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#667085"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Select an available time slot:"
        android:textColor="#173B57"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/offerSlotsSpinner"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input"
        android:padding="6dp" />

    <Button
        android:id="@+id/confirmOfferButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#2D8C88"
        android:text="Confirm &amp; Book Appointment"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />

</LinearLayout>
