<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header & Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dialogCategoryBadge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="H"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialogFacilityCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HEALTHCARE FACILITY"
                android:textColor="#087E91"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialogFacilityName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#073B63"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseDetails"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#66788A" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="#E2E8F0" />

    <!-- Address & Distance -->
    <TextView
        android:id="@+id/dialogFacilityAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        android:textColor="#475569"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/dialogFacilityDistance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#087E91"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Additional info: Phone & Hours -->
    <TextView
        android:id="@+id/dialogFacilityPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#334155"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/dialogFacilityHours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#334155"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Buttons Row: Call & Website -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCallFacility"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#0EA5E9"
            android:text="📞 Call"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnWebsiteFacility"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#0EA5E9"
            android:text="🌐 Website"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Main Actions: View on Map & Get Directions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFocusMap"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#F1F5F9"
            android:text="🗺 View on Map"
            android:textAllCaps="false"
            android:textColor="#073B63"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGetDirections"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#073B63"
            android:text="🧭 Get Directions"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Task Integration Button (Visible when launched from Care Task) -->
    <Button
        android:id="@+id/btnSelectForTask"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#059669"
        android:text="✓ Select Facility for Task"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
