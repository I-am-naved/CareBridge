<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#173B57"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/btnBackVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="CareBridge Voice Assistant"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Waveform / Audio Visualizer container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="10dp"
                android:gravity="center">

                <!-- Outer audio waves representation -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <TextView android:layout_width="4dp" android:layout_height="30dp" android:layout_marginHorizontal="3dp" android:background="#93C5FD"/>
                    <TextView android:layout_width="4dp" android:layout_height="50dp" android:layout_marginHorizontal="3dp" android:background="#60A5FA"/>
                    <TextView android:layout_width="4dp" android:layout_height="80dp" android:layout_marginHorizontal="3dp" android:background="#3B82F6"/>
                    <TextView android:layout_width="4dp" android:layout_height="110dp" android:layout_marginHorizontal="3dp" android:background="#2563EB"/>
                    <TextView android:layout_width="4dp" android:layout_height="140dp" android:layout_marginHorizontal="3dp" android:background="#1D4ED8"/>

                    <!-- Center Mic Button Container -->
                    <RelativeLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="#173B57">

                        <ImageButton
                            android:id="@+id/btnMicAssistant"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_centerInParent="true"
                            android:background="@android:color/transparent"
                            android:contentDescription="Tap to speak"
                            android:src="@android:drawable/ic_btn_speak_now"
                            app:tint="#FFFFFF" />

                    </RelativeLayout>

                    <TextView android:layout_width="4dp" android:layout_height="140dp" android:layout_marginHorizontal="3dp" android:background="#1D4ED8"/>
                    <TextView android:layout_width="4dp" android:layout_height="110dp" android:layout_marginHorizontal="3dp" android:background="#2563EB"/>
                    <TextView android:layout_width="4dp" android:layout_height="80dp" android:layout_marginHorizontal="3dp" android:background="#3B82F6"/>
                    <TextView android:layout_width="4dp" android:layout_height="50dp" android:layout_marginHorizontal="3dp" android:background="#60A5FA"/>
                    <TextView android:layout_width="4dp" android:layout_height="30dp" android:layout_marginHorizontal="3dp" android:background="#93C5FD"/>
                </LinearLayout>

            </FrameLayout>

            <TextView
                android:id="@+id/tvVoiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="How can I help you today?"
                android:textColor="#173B57"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Transcript & Answer Display Box -->
            <LinearLayout
                android:id="@+id/cardResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="#FFFFFF"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTranscript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#667085"
                    android:textSize="14sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/tvAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#173B57"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Prompt 1 -->
            <LinearLayout
                android:id="@+id/promptNextAppt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="&quot;What is my next appointment?&quot;"
                    android:textColor="#173B57"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Prompt 2 -->
            <LinearLayout
                android:id="@+id/promptTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="&quot;What tasks do I need to complete?&quot;"
                    android:textColor="#173B57"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Prompt 3 -->
            <LinearLayout
                android:id="@+id/promptWhereAppt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="&quot;Where is my next appointment?&quot;"
                    android:textColor="#173B57"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Prompt 4 -->
            <LinearLayout
                android:id="@+id/promptJourney"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:backgroundTint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔊"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="&quot;Read my care instructions.&quot;"
                    android:textColor="#173B57"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
