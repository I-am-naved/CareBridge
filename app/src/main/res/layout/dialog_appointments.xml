<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Healthcare Appointments"
            android:textColor="#173B57"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="View your scheduled appointments and review new follow-up offers from your care provider."
            android:textColor="#667085"
            android:textSize="13sp" />

        <!-- Available Offers Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="NEW APPOINTMENT OFFERS"
            android:textColor="#2D8C88"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/offersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/offersEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E8F5F2"
                android:padding="14dp"
                android:text="No new appointment offers at this time."
                android:textColor="#475467"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Scheduled Appointments Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="SCHEDULED APPOINTMENTS"
            android:textColor="#173B57"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/scheduledAppointmentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/scheduledEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F6F8FA"
                android:padding="14dp"
                android:text="Loading scheduled appointments..."
                android:textColor="#667085"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/closeAppointmentsButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Close"
                android:textColor="#667085" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
