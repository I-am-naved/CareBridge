<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/adminBackButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="0dp"
                android:paddingEnd="12dp"
                android:text="← Back"
                android:textColor="#173B57"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Admin Portal"
                android:textColor="#173B57"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/adminLogoutButton"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log Out"
                android:textColor="#D92D20"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Manage doctor availability, send appointment offers, and track patient confirmations in real time."
            android:textColor="#667085"
            android:textSize="13sp" />

        <!-- 1. Doctor Availability Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="DOCTOR AVAILABILITY STATUS"
            android:textColor="#2D8C88"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/doctorsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/doctorsEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="14dp"
                android:text="Loading doctor availability..."
                android:textColor="#667085"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- 2. Send Appointment Offer Form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send Appointment Offer to Patient"
                android:textColor="#173B57"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Select Patient User ID -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Target Patient (User ID / Email)"
                android:textColor="#173B57"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/adminPatientIdInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:hint="Enter patient User ID (e.g. john_doe)"
                android:inputType="text"
                android:padding="12dp"
                android:textSize="14sp" />

            <!-- Select Doctor -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Select Available Doctor"
                android:textColor="#173B57"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/adminDoctorSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:padding="8dp" />

            <!-- Department / Purpose -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Department / Service Name"
                android:textColor="#173B57"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/adminDeptInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:hint="e.g. Cardiology Follow-Up"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:textSize="14sp" />

            <!-- Time Slots -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Available Time Slot 1"
                android:textColor="#173B57"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/adminSlot1Input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:hint="e.g. Nov 22, 2026 at 10:00 AM"
                android:inputType="text"
                android:padding="12dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Available Time Slot 2"
                android:textColor="#173B57"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/adminSlot2Input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:hint="e.g. Nov 22, 2026 at 02:00 PM"
                android:inputType="text"
                android:padding="12dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/sendOfferButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#173B57"
                android:text="Send Offer &amp; Push Notification"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- 3. Sent Offers & Real-Time Confirmation List -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SENT OFFERS &amp; REAL-TIME CONFIRMATIONS"
            android:textColor="#173B57"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/adminOffersTrackerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/adminOffersEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="14dp"
                android:text="Loading sent offers..."
                android:textColor="#667085"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Bottom spacing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="30dp" />

    </LinearLayout>

</ScrollView>
